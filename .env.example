# Copy to .env and adjust. Never commit a real .env — it holds secrets.
# Generate secrets with:
#   ENCRYPTION_MASTER_KEY -> go run . encrypt generate-master
#   JWT_SECRET            -> openssl rand -base64 32

# ---- Docker Compose (local Postgres + Mailpit) ----
DB_USER=waggle
DB_PASSWORD=waggle
DB_NAME=waggle
LOCAL_POSTGRES_PORT=5432
LOCAL_BOUNCER_PORT=6432

# ---- HTTP server ----
BIND_HOST=localhost
BIND_PORT=8080
# BASE_URL=http://localhost:8080      # public URL used in email links
# BASE_PATH=/api/v1                   # API route prefix
# FRONTEND_MODE=embed                 # embed | proxy | none

# ---- Databases ----
DATABASE_URL=postgres://waggle:waggle@localhost:5432/waggle
# ADMIN_DATABASE_URL=                 # superuser DSN for tenant DB create/drop (defaults to /postgres)
# RIVER_DATABASE_URL=                 # job queue DSN (defaults to DATABASE_URL)

# ---- Encryption (KEK) — base64 of 32 random bytes ----
ENCRYPTION_MASTER_KEY=replace-me-with-go-run-.-encrypt-generate-master

# ---- JWT ----
JWT_SECRET=replace-me-with-a-random-secret
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=waggle
JWT_ACCESS_TTL_MIN=1440
JWT_REFRESH_TTL_HOUR=720

# ---- SMTP (omit SMTP_SERVER to log emails to stdout in dev) ----
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USER=noreply@waggle.com
SMTP_PASSWORD=somepassword
# SMTP_FROM=noreply@waggle.com

# ---- Hypervisor capacity headroom reserved on discovery ----
# RESERVE_CPU=0
# RESERVE_RAM_GB=2
# RESERVE_DISK_GB=10

# ---- Proxmox (per-datacenter token is set via the API, not here) ----
#PVE_API_TOKEN='root@pam!token=00000000-0000-0000-0000-000000000000'
#PVE_API_URL='pve://10.0.0.1:8006/?insecure=1'
