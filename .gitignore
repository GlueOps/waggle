# ---- Secrets & local environment ----
.env
.env.*
!.env.example

# ---- Go build output ----
/bin/
/waggle
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*

# GoReleaser / build artifacts (root only; ui/dist is handled separately)
/dist/

# ---- Node / frontend tooling (root workspace) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Yarn 4 (berry) local state. The cache lives outside the project
# (enableGlobalCache: true in .yarnrc.yml), so only install-state is left here.
# .yarnrc.yml and yarn.lock ARE tracked — they pin the toolchain.
**/.yarn/*
!**/.yarn/patches
!**/.yarn/releases

# ---- Code-gen / tooling scratch ----
repomix-readme.md
repomix-output.*

# ---- Editor / IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ---- OS noise ----
.DS_Store
Thumbs.db

# ---- Claude Code local overrides ----
.claude/settings.local.json

terraform/